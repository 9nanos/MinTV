<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET, ACCESS_NETWORK_STATE, FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC and
         POST_NOTIFICATIONS are declared by :core, together with WorkManager's foreground-service
         host: core is what does the networking and runs the sync/download worker. They merge in
         from there — see core/src/main/AndroidManifest.xml. -->

    <!-- In-app updates: hand the downloaded release APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- MODIFY_AUDIO_SETTINGS is declared by :player-core, which owns VolumeBoost. -->

    <!-- Android TV provider writes for Watch Next cards. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Downloads & backup to user-chosen folders (SAF's document picker is absent on most TVs).
         READ stays declared through API 32: dropping it left some OEM builds (TCL Android 12,
         "Permission Shield") with NO grantable storage entry at all — MANAGE_EXTERNAL_STORAGE alone
         is a special app access their settings never surface. With READ declared, requesting it on
         API 30–32 opens the system "Files and media" screen, which also lists
         "Allow management of all files" because MANAGE is declared. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Settings › App › Auto start. From Android 10 an app may open itself from the background only
         with "Display over other apps"; OwnTV asks for it when an auto-start option is turned on and
         draws nothing over other apps. RECEIVE_BOOT_COMPLETED merges in from :core. The wake listener
         is a specialUse foreground service: no other type describes waiting for the screen to come on. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- TV-first app, but allow non-TV installs too: touchscreen optional, and leanback is NOT required
         (required=true blocked plain phones / non-TV armv7a boxes that don't report the leanback feature). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- Voice search hands the listening to the system's speech recogniser, so no microphone permission
         is needed. From Android 11 the app can only see that recogniser if it names the action here;
         without it Search would hide the microphone even where one exists. -->
    <!-- Android 11+ package visibility for explicit external TV shortcuts. -->
    <queries>
        <!-- Public Twitch channel handlers and a public TV-client filter; no private URI parameters. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="www.twitch.tv" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="s0undtv" android:host="stream" />
        </intent>
        <package android:name="com.s0und.s0undtv" />
        <package android:name="com.fgl27.twitch" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="org.smarttube.stable" />
        <package android:name="org.smarttube.beta" />
        <package android:name="app.smarttube.fdroid" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.liskovsoft.smarttubetv.beta" />
        <package android:name="se.svt.android.svtplay" />
        <package android:name="se.telenor.stream" />
        <package android:name="com.android.vending" />

        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    
    </queries>

    <application
        android:name=".OwnTVApp"
        android:allowBackup="false"
        android:banner="${minTvBanner}"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/mintv_icon"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/mintv_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.OwnTV"
        android:usesCleartextTraffic="true">

        <!-- Exposes the downloaded update APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable WorkManager default auto-init; OwnTVApp provides Configuration. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- One launcher activity per icon colour (core's AppIcon); AppIconSwitcher keeps exactly one
             enabled. MainActivity is the default (Eggshell) and keeps its name, so an icon placed before this change still
             opens the app. Each carries its own icon, banner and launch-screen theme, and ALL intent
             filters: a disabled activity resolves nothing, so each variant's links always reach the enabled
             one. LEANBACK_LAUNCHER shows it on TV launchers; LAUNCHER on phone/tablet/box home screens.
             configChanges: a remote waking up (keyboard/navigation), an HDR or frame-rate mode switch
             (uiMode/colorMode/screen*) or a density change must not rebuild the Activity mid-film — that
             closed the player and re-ran the startup popups. locale|layoutDirection are left out on
             purpose: a script-family language switch still needs its one recreate (LocalizedContent).
             supportsPictureInPicture: Settings › Video player › Picture-in-picture when leaving the app;
             the window resizes the activity, which screenSize|smallestScreenSize|screenLayout keep alive. -->
        <activity
            android:name=".MainActivityPetrol"
            android:banner="${minTvBanner}"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/mintv_icon"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density|colorMode"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:roundIcon="@mipmap/mintv_icon"
            android:theme="@style/Theme.MinTV.Starting"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${minTvLinkScheme}" />
                <data android:host="play" />
                <data android:host="open" />
            </intent-filter>
        </activity>

